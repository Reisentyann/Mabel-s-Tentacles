server:
  port: 8080
  base_url: "http://localhost:8080"

data_dir: "./data"

log:
  level: "info"       # debug | info | warn | error
  format: "json"      # json | text
  file: "logs/server.log"   # 日志文件；空 = 只输出控制台

database:
  url: ""             # 留空则使用下面字段拼接
  host: "postgres"
  port: "5432"
  user: "postgres"
  password: "postgres"
  name: "agent_db"
  max_conns: 10

mcp:
  api_key: ""         # MCP 鉴权（Authorization: Bearer），空 = 关闭

api:
  access_token: ""    # HTTP 下载鉴权（query token），空 = 关闭
  require_auth: false # /api/* 是否需要 JWT；开发阶段 false，上线改 true
  download_base_url: "" # 对外下载地址前缀（如 http://你的域名:18080），空=不返回下载链接

security:
  secret_key: "supersecretkey"   # JWT 签名密钥（生产务必修改）
  algorithm: "HS256"
  access_token_expire_minutes: 30
  refresh_token_expire_days: 7

admin:
  username: "admin"              # 启动时自动创建的管理员
  password: "admin123"
