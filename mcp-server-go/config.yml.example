# config.yml 通用模板（入库）：所有字段全集参考——复制后按场景改名
#   开发：cp config.dev.yml config.yml（开发值已调好，可直接用）
#   生产：cp config.yml.example config.prod.yml（填真实值；config.prod.yml 已 gitignore，
#         适用于裸机直接运行；Docker 场景配置走环境变量 --env-file .env.production，yml 可不建）
#   加载顺序：内置默认值 → config.yml（CONFIG_PATH 可改路径）→ 环境变量（最高优先级）

server:
  port: 8080
  base_url: "http://localhost:8080"

data_dir: "./data"

log:
  level: "info"       # debug | info | warn | error
  format: "json"      # json | text
  file: "logs/server.log"   # 日志文件；空 = 只输出控制台

database:
  url: ""             # 留空则使用下面字段拼接
  host: "postgres"
  port: "5432"
  user: "postgres"
  password: "postgres"
  name: "agent_db"
  max_conns: 10

mcp:
  api_key: ""         # MCP master key（管家 agent，无限权限）；生产必配强随机值！空 = 开发放行（启动大红 WARN）

api:
  access_token: ""    # HTTP 下载鉴权（query token，agent 直发链接的过渡口径）；空 = 下载走 JWT
  require_auth: true  # /api/* 需要 JWT（安全默认）；本地开发裸奔设 REQUIRE_AUTH=false
  download_base_url: "" # 对外下载地址前缀（如 http://你的域名:18080），空=不返回下载链接

security:
  secret_key: "supersecretkey"   # JWT 签名密钥（生产务必修改）
  algorithm: "HS256"
  access_token_expire_minutes: 30
  refresh_token_expire_days: 7

admin:
  username: "admin"              # 启动时自动创建的管理员
  password: "admin123"
