server:
  port: 8001
  base_url: "http://localhost:8001"
  data_dir: "./data"

log:
  level: "info"       # debug | info | warn | error
  format: "json"      # json | text

database:
  url: ""             # 留空则使用下面字段拼接
  host: "postgres"
  port: "5432"
  user: "postgres"
  password: "postgres"
  name: "agent_db"
  max_conns: 10

auth:
  api_key: ""         # 留空 = 不启用鉴权；填了则客户端需带 Authorization: Bearer <key>
