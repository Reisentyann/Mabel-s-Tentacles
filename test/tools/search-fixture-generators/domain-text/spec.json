    {"id":"geography","name":"地理","special":"long-index","topics":["河流流域","海岸线变迁","城市区位","地形剖面"],"terms":["watershed","coastline","latitude","terrain"]},
    {"id":"geology","name":"地质","special":"glossary","topics":["地层年代","断层活动","矿物鉴定","火山喷发"],"terms":["stratum","fault","mineral","volcano"]},
    {"id":"meteorology","name":"气象","special":"crlf","topics":["锋面移动","气压变化","台风路径","降水概率"],"terms":["front","pressure","typhoon","rainfall"]},
