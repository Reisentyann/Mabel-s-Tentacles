          "extra_coverage": ["cod-text-headings","cod-text-structure","cod-text-link-domains","cod-text-link-domains-truncated","cod-text-code-languages","cod-text-code-languages-truncated","cod-text-section-paths","cod-text-section-paths-truncated","cod-text-table-headers","cod-text-table-headers-truncated"],
          "expect": {
            "cod-text-table-blocks": 1,
            "cod-text-table-rows": 3,
            "cod-text-table-cols": 31,
            "cod-text-link-domains-truncated": true,
