  "manifest_schema": {
    "schema_version": 1,
    "domain_id": "<id>",
    "domain_name": "<中文名>",
    "path_base": ".",
    "generated_by": "subagent:<agent-name>",
    "files": [
      {
        "path": "01-report.md",
        "archetype": "markdown-report",
        "bytes": 1234,
        "sha256": "<64 hex>",
        "marker": "SEARCH_DOMAIN_<ID>_REPORT_2026",
        "purpose": "<中文说明该文件用于验证什么>",
        "expected_coverage": "<本文件预期出现且经实际分析可验证的完整 cod-* 字段名数组>",
        "expect": {"<完整 cod-* 字段名>": "<精确值>"},
        "expected_absent_fields": [],
        "notes": "<可选：边界或限制>"
      }
    ]
  },
  "hard_rules": [
    "只写指定 domain 目录和该目录的 manifest.json；不得修改 describer、indexer、其他领域或现有夹具。",
    "不得读取 .env、data、logs、旧内容、旧文件或任何凭据。",
    "不得联网、安装依赖、启动 Docker、运行全量测试或生成大于 8 KiB 的文件。",
    "所有文件 UTF-8 无 BOM；不得生成图片、音视频、压缩包或大型二进制。",
    "marker 必须唯一且同时出现在文件和 manifest 中。",
    "common_coverage 仅用于批次字段覆盖设计，不要求每个文件清单逐项列出；按实际文件内容填写 expected_coverage。",
    "expected_coverage 必须使用完整 cod-* 字段名；只列本文件预期出现且可精确验证的字段，避免无条件堆叠不存在的条件字段。",
    "expect 只写模板明确要求且可精确验证的值；不得猜测字数、熵、平均行长等统计值。",
    "每个文件至少包含一个句末字符 . ! ? 。 ！ ？，保证 cod-text-avg-sent-len 可产出。",
    "除 05-records-broken.csv、06-minified.json、07-boundary.txt 外，extra_coverage 含 cod-text-top-keywords 的文件必须重复至少一个长度大于等于 3 的英文 term，或重复一个中文二元词至少两次。",
    "完成后返回：领域名、文件数、总字节、最大文件、manifest 路径、已知偏差。"
  ]
}
