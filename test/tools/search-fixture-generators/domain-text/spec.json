    "min_file_bytes": 256,
    "max_file_bytes": 8192,
    "max_domain_bytes": 65536,
    "max_total_bytes": 1048576,
    "encoding": "utf-8",
    "allow_bom": false
  },
  "marker_pattern": "SEARCH_DOMAIN_<DOMAIN_ID_UPPER>_<ARCHETYPE_UPPER>_2026",
  "legacy_reference": {
    "source": "C:\\Users\\Reisentyan\\Downloads\\幻觉",
    "reuse": [
      "调查摘要式 Markdown：H2 路径、两列表格、问题段落和引用块。",
      "服务日志：时间戳、重复 run_id/conversation_id、多行提示词和长行。",
      "伪表格负例：每个单元格单独成行，不含管道符，不应被识别为 Markdown 表格。"
