# Backend & Database Configuration
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=agent_db

# JWT Authentication
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_secure_jwt_secret_key_here

# Email Configuration (Optional, for MCP Server)
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password_or_app_key

# CORS Configuration
# Comma-separated list of allowed origins. Leave empty if proxying via Nginx on the same domain.
CORS_ORIGINS=http://your-domain.com,https://your-domain.com
