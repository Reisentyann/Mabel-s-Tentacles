{
  "force_segmented_reply": true,
  "interval_seconds": 2.7,
  "segment_length_threshold": 500,
  "max_segments": 4,
  "output_dir": "segmented_replies",
  "split_words": ["---", "\n---\n", "……", "?", "？", "!", "！", "。"],
  "content_filter": {
    "blocked_words": [],
    "replace_rules": {
      "敏感词示例": "***"
    }
  }
}
