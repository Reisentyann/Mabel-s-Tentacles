# 生产环境变量模板：cp .env.production.example .env.production 后填写真实值
# .env.production 已被 gitignore——真实凭据绝不入库；compose 不会自动读它，启动须带 --env-file
#
#   docker compose --env-file .env.production up -d --build
#
# 生成强随机值的参考（任一即可）：
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"

# 数据库
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_强数据库密码
POSTGRES_DB=agent_db

# JWT 签名密钥（必改：默认值会让任何人可伪造 token）
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# 管理员（启动自动创建/提升；首次登录后建议再改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_强管理员密码

# MCP master key（必配！空 = MCP 通道无鉴权放行，任何能访问 /sse 的客户端都拥有管家全权）
MCP_API_KEY=CHANGE_ME_强随机master_key

# HTTP 下载鉴权（query token，agent 直发链接的过渡口径；空 = 下载走 JWT）
ACCESS_TOKEN=

# 对外下载地址前缀（空 = 工具结果不返回下载链接）
DOWNLOAD_BASE_URL=http://你的域名:18080
