# 开发环境变量（入库版）：值全部是本地开发口径，无任何真实凭据——真实值只放 .env.production（已 gitignore）
# 用法：无需手动创建 .env——start-dev.ps1 找不到 .env 时自动读取本文件
# 生产模板：cp .env.production.example .env.production 填真实值

# 管理员（启动自动创建/提升）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 数据库（本地 Docker 映射 127.0.0.1:54322）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_db

# JWT 签名密钥（开发固定值）
JWT_SECRET=dev-secret-key

# ===== 路径（相对项目根，start-dev.ps1 会解析成绝对路径） =====
DATA_DIR=data
LOG_FILE=logs/server.log
